<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/homeBackground"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Format Selector -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/homeCardBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/importer_filter_title"
            android:textColor="@color/homeTextPrimary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/importer_format_spinner"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1" />

    </LinearLayout>

    <!-- Format Info -->
    <TextView
        android:id="@+id/importer_format_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:padding="8dp"
        android:text="@string/importer_no_files"
        android:textColor="@color/homeTextSecondary"
        android:textSize="13sp" />

    <!-- File List -->
    <ListView
        android:id="@+id/importer_file_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:background="@color/homeCardBackground"
        android:divider="@null" />

    <TextView
        android:id="@+id/importer_empty_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="@string/importer_empty"
        android:textColor="@color/homeTextSecondary"
        android:textSize="16sp"
        android:visibility="gone" />

    <!-- Options -->
    <CheckBox
        android:id="@+id/importer_batch_install"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/importer_batch_mode"
        android:textColor="@color/homeTextPrimary"
        android:textSize="14sp" />

    <!-- Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal"
        android:weightSum="2">

        <Button
            android:id="@+id/importer_pick_files"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@color/homeCardBackground"
            android:text="@string/importer_pick_files"
            android:textColor="@color/colorPrimary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/importer_install_btn"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@color/colorPrimary"
            android:text="@string/importer_install_disabled"
            android:textColor="@android:color/white"
            android:textSize="14sp"
            android:textStyle="bold" />

    </LinearLayout>

</LinearLayout>