<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/homeBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Status Bar -->
        <TextView
            android:id="@+id/magisk_status"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:gravity="center"
            android:text="@string/magisk_status_not_installed"
            android:textColor="@android:color/white"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- Toolbar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@color/homeCardBackground"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/magisk_module_list"
                android:textColor="@color/homeTextPrimary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/magisk_refresh"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/magisk_refresh"
                android:src="@android:drawable/ic_menu_rotate"
                android:tint="@color/homeTextPrimary" />

            <ImageButton
                android:id="@+id/magisk_inject_btn"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/home_magisk"
                android:src="@android:drawable/ic_menu_manage"
                android:tint="@color/homeTextPrimary" />

        </LinearLayout>

        <!-- Module List -->
        <ListView
            android:id="@+id/magisk_module_list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:divider="@null"
            android:dividerHeight="0dp"
            android:padding="8dp" />

        <!-- Empty View -->
        <TextView
            android:id="@+id/magisk_empty_view"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/magisk_no_modules"
            android:textColor="@color/homeTextSecondary"
            android:textSize="16sp"
            android:visibility="gone" />

    </LinearLayout>

    <com.github.clans.fab.FloatingActionButton
        android:id="@+id/magisk_install_fab"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:contentDescription="@string/magisk_install_module"
        android:src="@drawable/ic_add"
        app:fabSize="normal"
        app:fab_colorNormal="@color/colorPrimary"
        app:fab_colorPressed="@color/colorPrimaryDark"
        app:fab_colorRipple="@color/colorPrimaryOpacity"
        app:fab_label="@string/magisk_install_module"
        app:fab_size="normal" />

</FrameLayout>